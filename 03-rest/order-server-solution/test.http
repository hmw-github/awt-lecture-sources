# For the VS Code extension "REST Client" (Huachao Mao).
# REST Client has no automated assertions: send each request ("Send Request")
# and compare the response with the "Expect:" lines.
# A version with automated tests (JetBrains HTTP Client / httpYac) is in test.jetbrains.http.

@baseUrl = http://localhost:3000

### check if server is running
# Expect: 200, message containing "running"
GET {{baseUrl}}

### get all orders
# Expect: 200, application/json, array containing order 1 of "Rajesh", orders without position data
GET {{baseUrl}}/api/order

### get order 1
# Expect: 200, application/json, order 1 of "Rajesh" without position data
GET {{baseUrl}}/api/order/1

### get invalid order 4711
# Expect: 404
GET {{baseUrl}}/api/order/4711

### create order
# Expect: 201, the new order with a numeric id and customer "Paula".
# Send this request FIRST: the requests below use its id via {{orderID}}.
# @name createOrder
POST {{baseUrl}}/api/order
Content-Type: application/json

{
  "customer": "Paula",
  "date": "10 Oct 2025 10:20:00 GMT",
  "positions": []
}

### id of the order created above
@orderID = {{createOrder.response.body.$.id}}

### check new order
# Expect: 200, the created order of customer "Paula"
GET {{baseUrl}}/api/order/{{orderID}}

### update order
# Expect: 200
PUT {{baseUrl}}/api/order/{{orderID}}
Content-Type: application/json

{
  "id": {{orderID}},
  "customer": "Mohammed",
  "date": "1728556440000"
}

### verify update
# Expect: 200, customer "Mohammed", date "1728556440000"
GET {{baseUrl}}/api/order/{{orderID}}

### delete new order
# Expect: 200
DELETE {{baseUrl}}/api/order/{{orderID}}

### verify delete
# Expect: 404
GET {{baseUrl}}/api/order/{{orderID}}

### delete it again
# Expect: 404 (unknown order)
DELETE {{baseUrl}}/api/order/{{orderID}}

### update unknown order
# Expect: 404 (unknown order)
PUT {{baseUrl}}/api/order/4711
Content-Type: application/json

{
  "id": 4711,
  "customer": "Nobody",
  "date": "1728556440000"
}

### get positions for order 1
# Expect: 200, application/json, array with positions nr 1 and 2, each with nr (number), article, amount (number)
GET {{baseUrl}}/api/order/1/position

### get positions for unknown order
# Expect: 404
GET {{baseUrl}}/api/order/4711/position

### create new position 3 for order 1
# Expect: 201
POST {{baseUrl}}/api/order/1/position
Content-Type: application/json

{
  "nr": 3,
  "article": "Apple Watch for Friend",
  "amount": 1
}

### create position 3 again -> nr must be unique
# Expect: 404 (rejected)
POST {{baseUrl}}/api/order/1/position
Content-Type: application/json

{
  "nr": 3,
  "article": "Apple Watch for Friend",
  "amount": 1
}

### verify new position for order 1
# Expect: 200, position 3 with article "Apple Watch for Friend" and amount 1
GET {{baseUrl}}/api/order/1/position

### update position 3 for order 1
# Expect: 200
PUT {{baseUrl}}/api/order/1/position
Content-Type: application/json

{
  "nr": 3,
  "article": "Apple Watch",
  "amount": 2
}

### verify updated position for order 1
# Expect: 200, position 3 with article "Apple Watch" and amount 2
GET {{baseUrl}}/api/order/1/position

### delete position 3 for order 1
# Expect: 200
DELETE {{baseUrl}}/api/order/1/position/3

### verify deleted position for order 1
# Expect: 200, position 3 is gone, positions 1 and 2 still there
GET {{baseUrl}}/api/order/1/position

### delete position 3 again
# Expect: 404 (unknown position)
DELETE {{baseUrl}}/api/order/1/position/3
