@startuml order-server-request-flow
' Request flow of the order server (REST exercise)
' Preview in VS Code with the PlantUML extension: Alt+D

' ---------------------------------------------------------------
' Sequence view: GET /api/order/:id
' ---------------------------------------------------------------

title Request Flow – GET /api/order/:id

actor Client
participant "Express\n(server.ts)" as Express
participant "routes.ts" as Routes
participant "orderController" as Ctrl
participant "data.ts" as Data
participant "Order" as Order

Client -> Express : GET /api/order/1
Express -> Routes : match route
Routes -> Ctrl : getOrderById(req, res)
Ctrl -> Data : findOrderById(1)
Data --> Ctrl : Order | undefined
alt order found
  Ctrl -> Order : copyFrom(order)
  Order --> Ctrl : Order (without positions)
  Ctrl --> Client : 200 OK + JSON
else not found
  Ctrl --> Client : 404 Not Found
end
@enduml
